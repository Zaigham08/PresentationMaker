@code {
    private bool isLoading = false;
    private enum ViewMode
    {
        ByForm,
        ByChat
    }
    private MarkupString responseBodyHtml;
    private ViewMode currentView = ViewMode.ByForm;

    Presentation presentation = new Presentation();
    ChatPresentation chatPresentation = new ChatPresentation();

    List<string> optionsList = new List<string>{"Academic Elite","Minimalist Elegance","Azure Versatility","Universal Template"};

   
    private void ToggleView(ViewMode view)
    {
        currentView = view;
    }

    private async Task GeneratePresentation()
    {
        try
        {
            isLoading = true;

            var payload = new
            {
                topic = presentation.Topic,
                instructions = presentation.Instructions ?? "",
                number_of_pages = presentation.NumPages,
                negative_prompt = "",
                collection_name = "", 
                files = new string[] { }, 
                template_name = presentation.SelectedOption ?? optionsList[0] 
            };

            // Convert the payload to JSON
            var jsonPayload = JsonSerializer.Serialize(payload);

            // Set up the HttpClient
            using (var httpClient = new HttpClient())
            {
                // Set the request headers
                httpClient.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
                httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", "ZAIGHAMNETTTTTTTT!!1234!!CHUTIKRRRR!!!");

                // Set up the request content
                var content = new StringContent(jsonPayload, Encoding.UTF8, "application/json");

                // Make the POST request
                var response = await httpClient.PostAsync("https://api.academiai.org/class/temp/", content);

                // Handle the response as needed
                if (response.IsSuccessStatusCode)
                {
                    var presentationBytes = await response.Content.ReadAsByteArrayAsync();

                // Trigger file download using JavaScript interop
                await jsRuntime.InvokeVoidAsync("downloadFile", presentationBytes, $"{presentation.Topic}.pptx");
                    isLoading = false;
                }
                else
                {
                    isLoading = false;
                    var errorMessage = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error: {response.StatusCode}, Message: {errorMessage}");
                }
            }
        }
        catch (Exception ex)
        {
            // Print or log the exception information
            Console.WriteLine($"Exception: {ex.Message}");

            // If you want to log the exception to the browser console, you can use JavaScript interop
            //await jsRuntime.InvokeVoidAsync("console.error", $"Exception: {ex.Message}");
        }
    }

        private async Task GeneratePresentationWithChat()
    {
        try
        {
            isLoading = true;

            // Construct the request payload
            var payload = new
            {
                prompt = chatPresentation.Prompt,
                language = "English"
            };

            // Convert the payload to JSON
            var jsonPayload = JsonSerializer.Serialize(payload);

            // Set up the HttpClient
            using (var httpClient = new HttpClient())
            {
                // Set the request headers
                httpClient.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
                httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", "ZAIGHAMNETTTTTTTT!!1234!!CHUTIKRRRR!!!");

                // Set up the request content
                var content = new StringContent(jsonPayload, Encoding.UTF8, "application/json");

                // Make the POST request
                var response = await httpClient.PostAsync("https://api.academiai.org/class/temp/chat", content);

                // Handle the response as needed
                if (response.IsSuccessStatusCode)
                {
                    string responseBody = await response.Content.ReadAsStringAsync();
                    var link = ExtractLinkFromJson(responseBody);

                    // Create HTML content with a clickable link
                    responseBodyHtml = new MarkupString($"<div>Your Presentation is ready. Click this link below to download <a href='{link}' target='_blank'>{link}</a></div>");
                    isLoading = false;
                }
                else
                {
                    isLoading = false;
                    var errorMessage = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error: {response.StatusCode}, Message: {errorMessage}");
                  
                }
            }
        }
        catch (Exception ex)
        {
            // Print or log the exception information
            Console.WriteLine($"Exception: {ex.Message}");

        }
    string ExtractLinkFromJson(string json)
    {
        try
        {
            var jsonObject = JsonDocument.Parse(json);
            var root = jsonObject.RootElement;
            var response = root.GetProperty("response").GetString();
            
            var linkStartIndex = response.IndexOf('(') + 1;
            var linkEndIndex = response.IndexOf(')');
            var linkLength = linkEndIndex - linkStartIndex;
            
            return response.Substring(linkStartIndex, linkLength);
        }
        catch (Exception ex)
        {
            // Handle exception if JSON parsing fails
            return "Error extracting link";
        }
    }

}

}






















































