@page "/"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers
@using System.Net.Http
@using System.Text.Json
@using System.Text
@using System.Text.RegularExpressions
@using PresentationMaker.Models
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@inject HttpClient httpClient

        <!-- Portfolio Section-->
<section class="page-section portfolio" id="generate">
    <div class="container">
        <!-- Portfolio Section Heading-->
        <h2 class="text-center text-uppercase text-secondary mb-0">Generate Presentation</h2>
        <!-- Icon Divider-->
        <div class="divider-custom">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
            <div class="divider-custom-line"></div>
        </div>
        <!-- Portfolio Grid Items-->
        <div class="row justify-content-center">
            <div class="col-md-7">
                <!-- Toggle buttons for "By Form" and "By Chat" -->
                <div class="android-navbar mb-4">
                    <div @onclick="() => currentView = ViewMode.ByForm" class="android-navbar-item @((currentView == ViewMode.ByForm) ? "active" : "")">
                        By Form
                        <div class="android-navbar-indicator"></div>
                    </div>
                    <div @onclick="() => currentView = ViewMode.ByChat" class="android-navbar-item @((currentView == ViewMode.ByChat) ? "active" : "")">
                        By Chat
                        <div class="android-navbar-indicator"></div>
                    </div>
                </div>

                @if (currentView == ViewMode.ByForm)
                {
                    <EditForm Model="@presentation" OnValidSubmit="GeneratePresentation">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <br />
                        <div class="container">
                            <div class="row">
                                    <!-- Left-side fields -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="mb-1 fw-bold" for="topic" >Topic</label>
                                            <InputText id="topic" @bind-Value="presentation.Topic" class="form-control" placeholder="Enter the topic here" style="height: 60px;" />
                                        </div>
                                        <div class="form-group mt-3">
                                            <label class="mb-1 fw-bold" for="instructions" >Instructions</label>
                                            <InputText id="instructions" @bind-Value="presentation.Instructions" class="form-control" placeholder="Enter any special instructions " style="height: 60px;" />
                                        </div>
                                    </div>
                                    <!-- Right-side fields -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="mb-1 fw-bold" for="numPages" >Number of Pages</label>
                                            <InputNumber id="numPages" @bind-Value="presentation.NumPages" class="form-control" style="height: 60px;" />
                                        </div>
                                        <div class="form-group mt-3">
                                            <label class="mb-1 fw-bold" for="dropdown" >Template Name</label>
                                            <select class="form-control" id="dropdown" @bind="presentation.SelectedOption" style="height: 60px;">
                                                @foreach (var option in optionsList)
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            <br />
                            <div class="text-center mt-2 bt-3">
                                <button type="submit" class="btn btn-primary" style="height: 55px;">Generate presentation</button>
                            </div>
                        </div>
                    </EditForm>
                }
                else if (currentView == ViewMode.ByChat)
                {
                    <EditForm Model="@chatPresentation" OnValidSubmit="GeneratePresentationWithChat">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <br />
                        <!-- Render chat-related fields here -->
                        <div class="container">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label class="mb-1 fw-bold" for="topic">Describe what kind of presentation you want</label>
                                        <textarea id="desc" @bind="chatPresentation.Prompt" class="form-control" placeholder="Enter the text here" style="height: 160px;"></textarea>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="text-center mt-2 bt-3">
                                <button type="submit" class="btn btn-primary" style="height: 55px;">Generate presentation</button>
                            </div>
                            <br />
                            <p>@responseBodyHtml</p>
                        </div>
                    </EditForm>
                }

                <div class="loading-container" style="@($"display: {(isLoading ? "flex" : "none")}")">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


        <!-- About Section-->
        <section class="page-section bg-primary text-white mb-0" id="about">
            <div class="container">
                <!-- About Section Heading-->
                <h2 class="page-section-heading text-center text-uppercase text-white">About</h2>
                <p class="text-center lead">Learn more about our Presentation Generator.</p>
                <!-- Icon Divider-->
                <div class="divider-custom divider-light">
                    <div class="divider-custom-line"></div>
                    <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
                    <div class="divider-custom-line"></div>
                </div>
                <!-- About Section Content-->
                <div class="row">
                    <div class="col-lg-4 ms-auto"><p class="lead">Our mission is to simplify the process of creating presentations and empower individuals and teams to communicate their ideas effectively.</p></div>
                    <div class="col-lg-4 me-auto"><p class="lead">We are a dedicated team of designers and developers working together to provide you with the best presentation creation experience.</p></div>
                </div>
               
            </div>
        </section>
        <!-- Contact Section-->
        <section class="page-section" id="contact">
            <div class="container">
                <!-- Contact Section Heading-->
                <h2 class="page-section-heading text-center text-uppercase text-secondary ">Contact Us</h2>
                <!-- Icon Divider-->
                <div class="divider-custom">
                    <div class="divider-custom-line"></div>
                    <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
                    <div class="divider-custom-line"></div>
                </div>
                <!-- Contact Section Form-->
                <div class="row">
                    <div class="me-auto">
                        <p class="lead text-center">
                        We're here to help. Reach out to us with your questions and feedback.<br />
                        If you have any questions or need assistance, you can contact us at:
                        <br />
                        Email: contact@presentationgenerator.com
                        <br />
                        Phone: +1 (123) 456-7890
                    </p>
                    </div>
                </div>
            </div>
        </section>    

<style>
.android-navbar {
    display: flex;
    color: black;
    font-size: 18px;
    position: relative;
}
.android-navbar-item {
    cursor: pointer;
    padding: 16px;
}
