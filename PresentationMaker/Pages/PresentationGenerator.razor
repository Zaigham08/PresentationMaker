@page "/presentation"
@inject HttpClient HttpClient
@*@using newtonsoft.json *@

<PageTitle>Presentation Generator</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="text-center">Generate Presentation</h1>

            <EditForm Model="@presentation" OnValidSubmit="GeneratePresentation">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <br />
                <div class="form-group">
                    <label for="topic" class="mb-2">Topic</label>
                    <InputText id="topic" @bind-Value="presentation.Topic" class="form-control" placeholder="Enter the topic..." />
                </div>
                <div class="form-group mt-3">
                    <label for="instructions" class="mb-2">Instructions</label>
                    <InputText id="instructions" @bind-Value="presentation.Instructions" class="form-control" placeholder="Enter instructions..." />
                </div>
                <div class="form-group mt-3">
                    <label for="numPages" class="mb-2">Number of Pages</label>
                    <InputNumber id="numPages" @bind-Value="presentation.NumPages" class="form-control" placeholder="Enter the number of pages..." />
                </div>
                <div class="form-group mt-3">
                    <label for="negativeInstruction" class="mb-2">Negative Instruction</label>
                    <InputText id="negativeInstruction" @bind-Value="presentation.NegativeInstruction" class="form-control" placeholder="Enter negative instruction..." />
                </div>
                <br/>
                <div class="text-center mt-2">
                    <button type="submit" class="btn btn-primary">Generate presentation</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>


